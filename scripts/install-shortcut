#!/usr/bin/env bash
# Install the single evergreen OmniOutliner shortcut so Spotlight / GNOME search
# can find it. Re-run after moving the clone; the shortcut always launches current source.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
OPEN="$REPO/scripts/open"
ICON_SVG="$REPO/build/icon.svg"
ICON_PNG="$REPO/build/icon.png"
CONFIG_DIR="${OMNILOUTLINER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/OmniOutliner}"
BIN_DIR="${OMNILOUTLINER_BIN:-$HOME/.local/bin}"
APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_THEME="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor"
PIXMAP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pixmaps"
MAC_APP_DIR="${OMNILOUTLINER_MAC_APP:-$HOME/Applications}"
PLATFORM="${OMNILOUTLINER_PLATFORM:-$(uname -s)}"

desktop_dir() {
  local configured=""
  if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" ]]; then
    configured="$(sed -n 's/^XDG_DESKTOP_DIR="\(.*\)"/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" | head -n1)"
    configured="${configured/#\$HOME/$HOME}"
  fi
  if [[ -n "${XDG_DESKTOP_DIR:-}" ]]; then
    printf '%s\n' "$XDG_DESKTOP_DIR"
  elif [[ -n "$configured" ]]; then
    printf '%s\n' "$configured"
  elif [[ -d "$HOME/Desktop" ]]; then
    printf '%s\n' "$HOME/Desktop"
  fi
}

if [[ ! -x "$OPEN" ]]; then
  chmod +x "$OPEN"
fi
if [[ ! -f "$REPO/package.json" ]] || ! grep -q '"name": "omniliner"' "$REPO/package.json"; then
  echo "install-shortcut must run from the omniliner repo." >&2
  exit 1
fi

if [[ ! -f "$ICON_PNG" ]]; then
  python3 "$SCRIPT_DIR/generate-icon.py" "$REPO/build"
fi

mkdir -p "$CONFIG_DIR" "$BIN_DIR"
printf '%s\n' "$REPO" >"$CONFIG_DIR/repo"
ln -sfn "$OPEN" "$BIN_DIR/omnioutliner"

install_hicolor_icons() {
  local size dest
  mkdir -p "$ICON_THEME/scalable/apps" "$PIXMAP_DIR"
  if [[ -f "$ICON_SVG" ]]; then
    cp "$ICON_SVG" "$ICON_THEME/scalable/apps/omnioutliner.svg"
  fi
  for size in 16 32 48 64 128 256 512; do
    dest="$ICON_THEME/${size}x${size}/apps"
    mkdir -p "$dest"
    if [[ -f "$REPO/build/icon-${size}.png" ]]; then
      cp "$REPO/build/icon-${size}.png" "$dest/omnioutliner.png"
    elif [[ -f "$ICON_PNG" ]]; then
      cp "$ICON_PNG" "$dest/omnioutliner.png"
    fi
  done
  cp "$ICON_PNG" "$PIXMAP_DIR/omnioutliner.png"
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t "$ICON_THEME" >/dev/null 2>&1 || true
  fi
}

write_desktop_file() {
  local dest="$1"
  mkdir -p "$(dirname "$dest")"
  cat >"$dest" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=OmniOutliner
GenericName=Outliner
Comment=Open OmniOutliner from current source
Exec=$OPEN
TryExec=$OPEN
Icon=omnioutliner
Terminal=false
Categories=Office;
StartupNotify=true
MimeType=x-scheme-handler/omnioutliner;x-scheme-handler/omniliner;
Keywords=OmniOutliner;omniliner;outline;outliner;omni;
EOF
  chmod 755 "$dest"
}

write_desktop() {
  install_hicolor_icons
  write_desktop_file "$APP_DIR/omnioutliner.desktop"
  local desk
  desk="$(desktop_dir || true)"
  if [[ -n "$desk" ]]; then
    mkdir -p "$desk"
    write_desktop_file "$desk/OmniOutliner.desktop"
    if command -v gio >/dev/null 2>&1; then
      gio set "$desk/OmniOutliner.desktop" metadata::trusted true >/dev/null 2>&1 || true
    fi
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APP_DIR" >/dev/null 2>&1 || true
  fi
  if command -v xdg-desktop-menu >/dev/null 2>&1; then
    xdg-desktop-menu forceupdate >/dev/null 2>&1 || true
  fi
}

write_mac_app() {
  local app="$MAC_APP_DIR/OmniOutliner.app"
  local contents="$app/Contents"
  mkdir -p "$contents/MacOS" "$contents/Resources"
  cat >"$contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>OmniOutliner</string>
  <key>CFBundleDisplayName</key>
  <string>OmniOutliner</string>
  <key>CFBundleIdentifier</key>
  <string>com.omniliner.outliner</string>
  <key>CFBundleVersion</key>
  <string>6.2.1</string>
  <key>CFBundleShortVersionString</key>
  <string>6.2.1</string>
  <key>CFBundleExecutable</key>
  <string>OmniOutliner</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
EOF
  printf 'APPL????' >"$contents/PkgInfo"
  cat >"$contents/MacOS/OmniOutliner" <<EOF
#!/bin/bash
exec "$OPEN" "\$@"
EOF
  chmod +x "$contents/MacOS/OmniOutliner"
  cp "$ICON_PNG" "$contents/Resources/AppIcon.png"
  if command -v sips >/dev/null 2>&1 && command -v iconutil >/dev/null 2>&1; then
    local iconset="$contents/Resources/AppIcon.iconset"
    mkdir -p "$iconset"
    local src="$REPO/build/icon-512.png"
    [[ -f "$src" ]] || src="$ICON_PNG"
    sips -z 16 16 "$src" --out "$iconset/icon_16x16.png" >/dev/null
    sips -z 32 32 "$src" --out "$iconset/icon_16x16@2x.png" >/dev/null
    sips -z 32 32 "$src" --out "$iconset/icon_32x32.png" >/dev/null
    sips -z 64 64 "$src" --out "$iconset/icon_32x32@2x.png" >/dev/null
    sips -z 128 128 "$src" --out "$iconset/icon_128x128.png" >/dev/null
    sips -z 256 256 "$src" --out "$iconset/icon_128x128@2x.png" >/dev/null
    sips -z 256 256 "$src" --out "$iconset/icon_256x256.png" >/dev/null
    sips -z 512 512 "$src" --out "$iconset/icon_256x256@2x.png" >/dev/null
    sips -z 512 512 "$src" --out "$iconset/icon_512x512.png" >/dev/null
    sips -z 1024 1024 "$src" --out "$iconset/icon_512x512@2x.png" >/dev/null 2>/dev/null || true
    iconutil -c icns "$iconset" -o "$contents/Resources/AppIcon.icns" >/dev/null 2>&1 || true
    rm -rf "$iconset"
  fi
  # Spotlight indexes real .app bundles in ~/Applications; .command files often never appear.
  if command -v lsregister >/dev/null 2>&1; then
    lsregister -f "$app" >/dev/null 2>&1 || true
  elif [[ -x /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister ]]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app" >/dev/null 2>&1 || true
  fi
  if command -v mdimport >/dev/null 2>&1; then
    mdimport "$MAC_APP_DIR" >/dev/null 2>&1 || true
  fi
  local desk
  desk="$(desktop_dir || true)"
  if [[ -n "$desk" ]]; then
    mkdir -p "$desk"
    rm -rf "$desk/OmniOutliner.app"
    cp -R "$app" "$desk/OmniOutliner.app"
  fi
  # Remove the old .command launcher so search results are not split.
  rm -f "$MAC_APP_DIR/OmniOutliner.command"
}

case "$PLATFORM" in
  Darwin)
    write_mac_app
    echo "Shortcut: $MAC_APP_DIR/OmniOutliner.app"
    echo "Search Spotlight for OmniOutliner (Applications folder)."
    ;;
  *)
    write_desktop
    echo "Shortcut: $APP_DIR/omnioutliner.desktop"
    echo "Search Activities / the app grid for OmniOutliner."
    ;;
esac

echo "Command:  $BIN_DIR/omnioutliner"
echo "Source:   $REPO"
echo "This shortcut always launches the working tree — new code is picked up without rebuilding an installer."
if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
  echo "Note: add $BIN_DIR to PATH to use the omnioutliner command from a terminal."
fi
